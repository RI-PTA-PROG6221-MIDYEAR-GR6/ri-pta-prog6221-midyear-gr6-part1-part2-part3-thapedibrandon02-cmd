<Window x:Class="CybersecurityAwarenessBot2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="700" Width="1100"
        Background="#0B1220"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Chat Area -->
            <ColumnDefinition Width="1*"/>
            <!-- Task List Area -->
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT COLUMN: CHAT ================= -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ASCII Logo -->
            <Border Grid.Row="0" Background="#111C33" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#7FDBFF"
                           TextAlignment="Center"
                           Text="&#x0a;   _____      _                _____ ______ _____ &#x0a;  / ____|    | |              / ____|  ____/ ____|&#x0a; | |    _   _| |__   ___ _ __| (___ | |__ | |     &#x0a; | |   | | | | '_ \ / _ \ '__|\___ \|  __|| |     &#x0a; | |___| |_| | |_) |  __/ |   ____) | |___| |____ &#x0a;  \_____\__, |_.__/ \___|_|  |_____/|______\_____|&#x0a;         __/ |                                     &#x0a;        |___/    Awareness Bot                    "/>
            </Border>

            <!-- Chat log -->
            <Border Grid.Row="1" Background="#0F1A2E" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatPanel" />
                </ScrollViewer>
            </Border>

            <!-- Input row -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput" Grid.Column="0"
                         FontSize="14" Padding="10"
                         Background="#16233D" Foreground="White"
                         BorderBrush="#2E4A7A" BorderThickness="1"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInput_KeyDown"/>

                <Button x:Name="SendButton" Grid.Column="1"
                        Content="Send"
                        Margin="10,0,0,0"
                        FontSize="14" FontWeight="Bold"
                        Background="#00B4D8" Foreground="White"
                        BorderThickness="0"
                        Click="SendButton_Click"/>
            </Grid>

            <!-- Status bar -->
            <TextBlock Grid.Row="3" x:Name="StatusText"
                       Foreground="#8AA9C9" FontSize="11"
                       Margin="0,8,0,0"
                       Text="Type a message and press Enter…"/>
        </Grid>

        <!-- ================= RIGHT COLUMN: TASKS & GAME ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Task List -->
            <Border Grid.Row="0" Background="#0F1A2E" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Cybersecurity Checklist" 
                               Foreground="#7FDBFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" x:Name="TaskListBox" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}" 
                                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                          Foreground="White" FontSize="13" Margin="0,5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Mini-Game -->
            <Border Grid.Row="1" Background="#111C33" CornerRadius="10" Padding="15">
                <StackPanel>
                    <TextBlock Text="Phishing Mini-Game" Foreground="#FFD166" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="GameQuestion" Text="Click Start to play!" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="GameButton" Content="Start Game" 
                                Background="#FFD166" Foreground="Black" FontWeight="Bold" 
                                Padding="10" Margin="0,0,5,0" Click="GameButton_Click"/>

                        <Button x:Name="SafeButton" Content="THIS IS SAFE" 
                                Background="#06D6A0" Foreground="Black" FontWeight="Bold" 
                                Padding="10" Click="SafeButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>